# Produção (KingHost). Crie /apps_wsgi/api/.env NO SERVIDOR a partir deste modelo.
# Nunca versionar o .env nem colocar valores reais neste arquivo.

# Prefixo em que a KingHost monta a app (nome da aplicação no painel). Padrão /api.
PUBLIC_BASE_PATH=/api
APP_ENV=production

# Gere no servidor: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=<chave-aleatoria-48+>

# Front e API ficam no mesmo domínio (mesma origem), mas mantemos a lista explícita.
CORS_ORIGINS=https://www.investimentos.kinghost.net

# Swagger em produção: DESLIGADO por padrão. A linha abaixo liga o Swagger (/api/docs/swagger).
# Use só para diagnóstico/teste e REMOVA depois (ou troque para false), pois expõe o mapa da API.
DOCS_ENABLED=true

LOG_LEVEL=INFO

# --- Banco de dados: base MASTER (produção) ---------------------------------------------------
# DB_TARGET é derivado do ambiente (production => master); não precisa declarar.
DB_HOST=<host-mysql>
DB_PORT=3306
DB_USER=<usuario-master>
DB_PASSWORD=<senha-master>
DB_NAME=<base-master>

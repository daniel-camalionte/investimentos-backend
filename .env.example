# Copie para .env (nunca versione o .env) e ajuste.
# Em produção, prefira definir estas variáveis no ambiente do servidor.

# development (local/stg) | staging | production | testing
APP_ENV=development

# Obrigatória em produção: mínimo de 32 caracteres aleatórios.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-em-desenvolvimento-somente

# Origens permitidas no CORS, separadas por vírgula (URL do frontend).
CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# Limite global por IP (formato do Flask-Limiter). Armazenamento em memória é por processo.
RATE_LIMIT_DEFAULT=120 per minute
RATE_LIMIT_STORAGE_URI=memory://

# Tamanho máximo do corpo da requisição, em bytes (padrão 1 MB).
MAX_CONTENT_LENGTH=1048576

# Documentação Swagger em /docs/swagger. Padrão: ligada fora de produção, desligada em produção.
# DOCS_ENABLED=false

# Prefixo público da API (padrão /api). Em produção a hospedagem monta a app nele.
# PUBLIC_BASE_PATH=/api

# --- Banco de dados (MySQL/MariaDB) ---------------------------------------------------------
# LOCAL = sempre a base STG. A aplicação recusa DB_TARGET=master fora de produção.
# Peça as credenciais ao responsável; nunca as versione.
DB_TARGET=stg
DB_HOST=<host-mysql>
DB_PORT=3306
DB_USER=<usuario-stg>
DB_PASSWORD=<senha-stg>
DB_NAME=<base-stg>

# Pool (padrões conservadores para hospedagem compartilhada) — opcionais:
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=2
# DB_POOL_RECYCLE=280
# DB_CONNECT_TIMEOUT=10
